{
  "name": "ios-gps-by-bravehoang",
  "version": "1.0.2",
  "description": "IOS GPS Location by BraveHoang",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable nsis"
  },
  "keywords": [],
  "author": "BraveHoang",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/huydung2002/fake-gps-mobile.git"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.bravehoang.iosgpsspoof",
    "productName": "IOS GPS by BraveHoang",
    "directories": {
      "output": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "huydung2002",
        "repo": "fake-gps-mobile"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "iconapp.png",
      "signAndEditExecutable": false,
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  }
}